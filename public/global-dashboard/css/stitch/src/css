.sx *,.sx ::before,.sx ::after{box-sizing:border-box;border-width:0;border-style:solid;border-color:rgb(var(--sx-outline-variant))}
.sx h1,.sx h2,.sx h3,.sx h4,.sx p,.sx ul,.sx ol,.sx li,.sx dl,.sx dd{margin:0;padding:0;list-style:none}
.sx table{min-width:0;width:100%;border-collapse:collapse}
.sx th,.sx td{padding:0;font-size:inherit;font-weight:inherit;white-space:normal;text-align:left;background:none;color:inherit;border-bottom:0}
.sx button{background:none;padding:0;text-align:inherit}
.sx button:disabled{cursor:not-allowed;opacity:.5}
.sx input,.sx select,.sx textarea{font:inherit;color:inherit;background:transparent}
.sx select{appearance:auto}
.sx a{color:inherit}
.sx :focus-visible{outline:2px solid rgb(var(--sx-primary));outline-offset:2px}
.sx dialog{color:rgb(var(--sx-on-surface))}
.sx dialog::backdrop{background:rgba(20,10,30,.55)}
.sx .msi{font-size:20px;width:1em;height:1em;fill:currentColor;display:inline-block;vertical-align:middle;flex:none}
.sx .scroll-thin::-webkit-scrollbar{width:6px;height:6px}
.sx .scroll-thin::-webkit-scrollbar-thumb{background:rgba(125,115,135,.45);border-radius:4px}
/* scroll containers must be positioned so absolutely placed children (e.g. .sr-only) are clipped with them */
.sx .overflow-x-auto,.sx .overflow-y-auto{position:relative}
@media (prefers-reduced-motion:reduce){.sx *{animation:none!important;transition:none!important}}
@tailwind utilities;
